{
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop-lite",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install uv && uv sync"
}
